<Window x:Class="PL.Delivery.DeliveryAddUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delivery" Width="620" Height="450">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===== Delivery Id (Update only) ===== -->

        <TextBlock Grid.Row="0"
                   Text="Delivery Id:"
                   Visibility="{Binding ButtonText,
                                Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

        <TextBox Grid.Row="0"
                 Text="{Binding CurrentDelivery.Id}"
                 Visibility="{Binding ButtonText,
                              Converter={StaticResource ConvertUpdateToVisibleKey}}"
                 IsReadOnly="True"/>


        <!-- ===== Source Clinic ===== -->

        <TextBlock Grid.Row="1" Text="Source Clinic:"/>
        <TextBox Grid.Row="1"
                 Text="{Binding CurrentDelivery.SourceClinic,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>


        <!-- ===== Target Lab ===== -->

        <TextBlock Grid.Row="2" Text="Target Lab:"/>
        <TextBox Grid.Row="2"
                 Text="{Binding CurrentDelivery.TargetLab,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>


        <!-- ===== Delivery Status (ENUM) ===== -->

        <TextBlock Grid.Row="3" Text="Status:"/>
        <ComboBox Grid.Row="3"
                  ItemsSource="{StaticResource DeliveryStatusCollectionKey}"
                  SelectedValue="{Binding CurrentDelivery.Status,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"/>


        <!-- ===== Save Button (Add/Update) ===== -->

        <Button Grid.Row="4"
                Content="{Binding ButtonText}"
                Click="BtnSave_Click"
                Width="160" Height="36"
                HorizontalAlignment="Center"/>

    </Grid>
</Window>
