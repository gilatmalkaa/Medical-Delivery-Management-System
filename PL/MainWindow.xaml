<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medical Delivery System"
        Height="480"
        Width="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF2F7">

    <Grid>
        <!-- Login Card -->
        <Border Background="White"
                CornerRadius="16"
                Padding="36"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <!-- Shadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  ShadowDepth="0"
                                  Color="#000000"
                                  Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Log in to System"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- ID -->
                <TextBlock Text="ID"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="IdBox"
                         Height="40"
                         FontSize="14"
                         Padding="10"
                         Background="#F9FAFB"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         Margin="0,0,0,18">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#22C55E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             FontSize="14"
                             Padding="10"
                             Background="#F9FAFB"
                             BorderBrush="#D1D5DB"
                             BorderThickness="1"
                             Margin="0,0,0,12"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#DC2626"
                           FontSize="12"
                           Margin="0,0,0,16"
                           Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button Content="Login"
                        Height="44"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#22C55E"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Login_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder"
                                            Property="Background"
                                            Value="#16A34A"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder"
                                            Property="Opacity"
                                            Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
