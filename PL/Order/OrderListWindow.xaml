<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orders List"
        Height="640"
        Width="900"
        Background="#F5F6FA"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔹 HEADER BAR -->
        <DockPanel Grid.Row="0" Margin="0 0 0 10">

            <TextBlock Text="Orders Management"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#333"
                       DockPanel.Dock="Left"/>

            <ComboBox SelectedValue="{Binding SelectedStatus}"
                      ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                      SelectionChanged="StatusFilter_SelectionChanged"
                      Width="150"
                      Margin="10 0 0 0"
                      DockPanel.Dock="Right"/>
        </DockPanel>


        <!-- 🔹 DATA GRID -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding OrderList}"
                  SelectedItem="{Binding SelectedOrder}"
                  MouseDoubleClick="OrdersList_MouseDoubleClick"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  Background="#FAFAFA"
                  AlternatingRowBackground="#F1F1F1"
                  BorderBrush="#B5B5B5"
                  BorderThickness="1">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="200"/>
                <DataGridTextColumn Header="Status" Binding="{Binding OrderStatus}" Width="150"/>

                <DataGridTemplateColumn Header="Active">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsActive}" IsEnabled="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Delete" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete"
                                    Padding="5"
                                    Margin="3"
                                    Background="#E53935"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Click="BtnDelete_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>


        <!-- 🔹 FOOTER BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">

            <Button Content="Add Order"
                    Padding="10 5"
                    Margin="5"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Width="120"
                    Click="btnAddOrder_Click"/>

        </StackPanel>

    </Grid>
</Window>
