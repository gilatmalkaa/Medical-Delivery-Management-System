<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orders Management"
        Height="640"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <!-- Colors -->
        <SolidColorBrush x:Key="BgCard" Color="White"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="Success" Color="#16A34A"/>
        <SolidColorBrush x:Key="Warning" Color="#FB8C00"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#6B7280"/>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Small Action Button -->
        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>

                <TextBlock Text="Orders Management"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextMain}"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                    Margin="20,0,0,0">

                    <ComboBox Width="160"
                              SelectedValue="{Binding SelectedStatus}"
                              ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                              SelectionChanged="StatusFilter_SelectionChanged"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= ORDERS GRID ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding OrderList}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="None"
                      AlternatingRowBackground="#F9FAFB"
                      HeadersVisibility="Column"
                      MouseDoubleClick="OrdersList_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding OrderId}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Air Distance"
                                        Binding="{Binding AirDistance}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Order Status"
                                        Binding="{Binding OrderStatus}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Schedule Status"
                                        Binding="{Binding ScheduleStatus}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Time Remaining"
                                        Binding="{Binding TimeRemaining}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Handling Time"
                                        Binding="{Binding HandlingTime}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Deliveries"
                                        Binding="{Binding DeliveriesCount}"
                                        Width="100"/>

                    <!-- Active -->
                    <DataGridTemplateColumn Header="Active" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsActive, Mode=OneWay}"
          IsEnabled="False"
          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Cancel -->
                    <DataGridTemplateColumn Header="Cancel" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel"
                                        Style="{StaticResource GridActionButton}"
                                        Background="{StaticResource Warning}"
                                        Visibility="{Binding CanCancel,
                                                     Converter={StaticResource BoolToVisibility}}"
                                        Click="BtnCancel_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Delete -->
                    <DataGridTemplateColumn Header="Delete" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Style="{StaticResource GridActionButton}"
                                        Background="{StaticResource Danger}"
                                        Click="BtnDelete_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= FOOTER ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <Button Content="Add Order"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource Success}"
                    Click="btnAddOrder_Click"/>
        </StackPanel>

    </Grid>
</Window>
