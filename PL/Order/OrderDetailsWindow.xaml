<Window x:Class="PL.Order.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL.Order"
        xmlns:core="clr-namespace:PL"
        Title="Order Details" Height="450" Width="650">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ===== Id field (shown only in Update) ===== -->

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Order Id:"
                   Visibility="{Binding ButtonText,
                                Converter={StaticResource ConvertUpdateToVisibleKey}}"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding CurrentOrder.Id}"
                 IsReadOnly="{Binding ButtonText,
                              Converter={StaticResource ConvertUpdateToTrueKey}}"
                 Visibility="{Binding ButtonText,
                              Converter={StaticResource ConvertUpdateToVisibleKey}}"
                 Width="150"
                 VerticalAlignment="Center"/>


        <!-- ===== Customer Name ===== -->

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Customer Name:"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding CurrentOrder.CustomerName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                 Width="180"
                 VerticalAlignment="Center"/>


        <!-- ===== Order Status ===== -->

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Order Status:"
                   VerticalAlignment="Center"/>

        <ComboBox Grid.Row="3" Grid.Column="1"
          ItemsSource="{StaticResource OrderStatusCollectionKey}"
          SelectedValue="{Binding CurrentOrder.OrderStatus,
                                  Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
          Width="180"
          VerticalAlignment="Center"/>

        <!-- ===== Example of NON-RELEVANT field – hidden always (9ג) ===== -->

        <TextBlock Grid.Row="4" Grid.Column="0"
           Text="Not Relevant Field:"
           Visibility="Collapsed"/>

        <TextBox Grid.Row="4" Grid.Column="1"
         Text="{Binding CurrentOrder.NotRelevant}"
         Visibility="Collapsed"/>

        <TextBox Text="{Binding CurrentOrder.Id}"
         IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"
         Width="120"/>

        <Label Content="Registration Date:"
       Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

        <DatePicker SelectedDate="{Binding CurrentOrder.RegistrationDate}"
            IsEnabled="False"
            Visibility="{Binding ButtonText, Converter={StaticResource ConvertUpdateToVisibleKey}}"/>

    </Grid>
</Window>
