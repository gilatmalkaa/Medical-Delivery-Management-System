<Window x:Class="PL.Order.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Details"
        Height="820"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <SolidColorBrush x:Key="CardBg" Color="White"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#6B7280"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>

        <Style x:Key="ReadOnly" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="CleanDataGrid" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LeftCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <TextBlock Text="Order Details"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"
                       Margin="0,0,0,20"/>

            <!-- ===== ORDER SUMMARY (READ ONLY) ===== -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Order ID"/>
                        <TextBox Text="{Binding CurrentOrder.Id}"
         Style="{StaticResource Input}"
         IsReadOnly="{Binding IsUpdateMode}"/>
                        
                        <TextBlock Style="{StaticResource Label}" Text="Order Status"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.OrderStatus}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Schedule Status"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.ScheduleStatus}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="Created At"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.CreatedAt}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Expected Delivery"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.ExpectedDeliveryTime}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Max Delivery Time"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.MaxDeliveryTime}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="Air Distance (km)"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.AirDistance}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Time Remaining"/>
                        <TextBox Style="{StaticResource ReadOnly}" Text="{Binding CurrentOrder.TimeRemaining}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== EDITABLE DETAILS ===== -->
            <Border Grid.Row="2"
        Style="{StaticResource Card}"
        IsEnabled="{Binding CurrentOrder.OrderStatus,
                            Converter={StaticResource OrderOpenOnlyConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource Label}" Text="Customer Name"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding CurrentOrder.CustomerName}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Phone"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding CurrentOrder.CustomerPhone}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Address"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding CurrentOrder.Address}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="Order Type"/>
                        <ComboBox Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding OrderTypes}"
                                  SelectedItem="{Binding CurrentOrder.Type}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Package Volume / Weight"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding CurrentOrder.PackageDetails}"/>

                        <TextBlock Style="{StaticResource Label}" Text="Description"/>
                        <TextBox Style="{StaticResource Input}"
                                 Height="90"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Text="{Binding CurrentOrder.Description}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== DELIVERIES LIST (REQUIRED) ===== -->
            <Border Grid.Row="3"
        Style="{StaticResource Card}"
        Visibility="{Binding CurrentOrder.Deliveries.Count,
                             Converter={StaticResource IntToVisibilityConverter}}">

                <StackPanel>

                    <TextBlock Text="Deliveries"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

                    <DataGrid Style="{StaticResource CleanDataGrid}"
                  ItemsSource="{Binding CurrentOrder.Deliveries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#F9FAFB">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Courier ID"
                        Width="110"
                        Binding="{Binding CourierId}"
                        ElementStyle="{StaticResource LeftCell}"/>

                            <DataGridTextColumn Header="Courier Name"
                        Width="*"
                        Binding="{Binding CourierName}"
                        ElementStyle="{StaticResource LeftCell}"/>

                            <DataGridTextColumn Header="Courier Type"
                        Width="130"
                        Binding="{Binding CourierType}"
                        ElementStyle="{StaticResource CenterCell}"/>

                            <DataGridTextColumn Header="Start Time"
                        Width="180"
                        Binding="{Binding StartDeliveryDate,
                                  StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                        ElementStyle="{StaticResource CenterCell}"/>

                            <DataGridTextColumn Header="Delivery Status"
                        Width="150"
                        Binding="{Binding CompletionStatus}"
                        ElementStyle="{StaticResource CenterCell}"/>

                            <DataGridTextColumn Header="End Time"
                        Width="180"
                        Binding="{Binding EndDeliveryDate,
                                  TargetNullValue='—',
                                  StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                        ElementStyle="{StaticResource CenterCell}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>


            <!-- ===== ACTIONS ===== -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding ButtonText}"
        Style="{StaticResource PrimaryButton}"
        Click="BtnSave_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>
