<Window x:Class="PL.Courier.ChooseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Order"
        Height="540"
        Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- ===== HEADER STYLE ===== -->
        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- ===== CARD ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===== DATAGRID HEADER ===== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <!-- ===== DATAGRID ROW ===== -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== CHOOSE BUTTON ===== -->
        <Style x:Key="ChooseButton" TargetType="Button">
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="90"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EA580C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Available Orders" Style="{StaticResource HeaderTitle}"/>
            <TextBlock Text="Select an order to assign to the courier"
                       Foreground="#6B7280"
                       FontSize="13"/>
        </StackPanel>

        <!-- ===== TABLE CARD ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding OpenOrders}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeight="44"
                      GridLinesVisibility="None"
                      Background="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Order ID"
                                        Binding="{Binding OrderId}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Order Type"
                                        Binding="{Binding Type}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding ItemCategory}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding Address}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Air Distance (km)"
                                        Binding="{Binding AirDistance, StringFormat={}{0:F1}}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Remaining Time"
                                        Binding="{Binding RemainingTime, StringFormat={}{0:hh\\:mm\\:ss}}"
                                        Width="150"/>

                    <!-- ACTION -->
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Choose"
                                        Style="{StaticResource ChooseButton}"
                                        Click="BtnAssign_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
