<Window x:Class="PL.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="d"
        Title="Admin Panel - Medical Delivery System"
        Height="500"
        Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Closed="AdminWindow_Closed">


    <!-- Main layout grid -->
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- System clock -->
            <RowDefinition Height="Auto"/>
            <!-- Time control buttons -->
            <RowDefinition Height="*"/>
            <!-- Configuration -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- Database actions -->
        </Grid.RowDefinitions>

        <!-- System Time Section -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Label Content="System Time:"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

            <Label Content="{Binding CurrentTime}"
                   FontWeight="Bold"
                   FontSize="20"
                   VerticalAlignment="Center"/>
        </StackPanel>

        <!-- System Time Control Buttons -->
        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,15">

            <Button Content="Add One Minute"
            Margin="5"
            Click="btnAddOneMinute_Click"/>

            <Button Content="Add One Hour"
            Margin="5"
            Click="btnAddOneHour_Click"/>

            <Button Content="Add One Day"
            Margin="5"
            Click="btnAddOneDay_Click"/>

            <Button Content="Add One Month"
            Margin="5"
            Click="btnAddOneMonth_Click"/>

            <Button Content="Add One Year"
            Margin="5"
            Click="btnAddOneYear_Click"/>

        </StackPanel>


        <!-- Configuration Section -->
        <GroupBox Grid.Row="2"
          Header="System Configuration"
          Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Max Range -->
                <Label Content="Max Range (km):"
               Grid.Row="0"
               Grid.Column="0"/>

                <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Width="80"
                 Text="{Binding Configuration.MaxRange,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Sample Expiration -->
                <Label Content="Sample Expiration (minutes):"
               Grid.Row="1"
               Grid.Column="0"/>

                <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Width="80"
                 Text="{Binding Configuration.SampleExpirationMinutes,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Max Delivery Duration -->
                <Label Content="Max Delivery Duration (minutes):"
               Grid.Row="2"
               Grid.Column="0"/>

                <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Width="80"
                 Text="{Binding Configuration.MaxDeliveryDurationMinutes,
                                UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Update Button -->
                <Button Content="Update Configuration"
                Grid.Row="0"
                Grid.Column="2"
                Grid.RowSpan="3"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Click="btnUpdateConfig_Click"/>
            </Grid>
        </GroupBox>


        <!-- Navigation Section -->
        <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,15,0,15">

            <Button Content="Manage Couriers"
            Margin="5"
            Click="btnCouriers_Click"/>

            <Button Content="Manage Deliveries"
            Margin="5"
            Click="btnDeliveries_Click"/>

            <Button Content="Manage Orders"
            Margin="5"
            Click="btnOrders_Click"/>

        </StackPanel>


        <!-- Database Actions -->
        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button Content="Initialize Database"
            Margin="5"
            Click="btnInitDB_Click"/>

            <Button Content="Reset Database"
            Margin="5"
            Click="btnResetDB_Click"/>

        </StackPanel>

    </Grid>
</Window>
