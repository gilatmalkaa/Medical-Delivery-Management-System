<Window x:Class="PL.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel - Medical Delivery System"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Closed="AdminWindow_Closed">

    <!-- ===== STYLES ===== -->
    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

    </Window.Resources>

    <ScrollViewer>
        <StackPanel Margin="24">

            <!-- HEADER -->
            <TextBlock Text="Admin Panel"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- TOP GRID -->
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- SYSTEM TIME -->
               <Button x:Name="SimulatorToggleButton"
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Content="Start Simulator"
        Style="{StaticResource PrimaryButton}"
        Click="btnSimulatorToggle_Click"
        Margin="0,0,0,12"/>

                <Border Grid.Row="1"
        Grid.Column="0"
        Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="System Time" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding CurrentTime}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <WrapPanel>
                            <Button x:Name="BtnMinute"
        Content="Minute"
        Style="{StaticResource PrimaryButton}"
        Click="btnAddOneMinute_Click"/>

                            <Button x:Name="BtnHour"
        Content="Hour"
        Style="{StaticResource PrimaryButton}"
        Click="btnAddOneHour_Click"/>

                            <Button x:Name="BtnDay"
        Content="Day"
        Style="{StaticResource PrimaryButton}"
        Click="btnAddOneDay_Click"/>

                            <Button x:Name="BtnMonth"
        Content="Month"
        Style="{StaticResource PrimaryButton}"
        Click="btnAddOneMonth_Click"/>

                            <Button x:Name="BtnYear"
        Content="Year"
        Style="{StaticResource PrimaryButton}"
        Click="btnAddOneYear_Click"/>

                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ORDERS SUMMARY -->
                <Border Grid.Row="1"
        Grid.Column="1"
        Style="{StaticResource Card}"
        Margin="10,0,0,16">
                    <StackPanel>

                        <TextBlock Text="Orders Summary"
                   Style="{StaticResource SectionTitle}"
                   Margin="0,0,0,12"/>

                        <!-- ===== STATUS SUMMARY ===== -->
                        <UniformGrid Columns="2" Rows="2">

                            <!-- CREATED -->
                            <Button Click="btnOrders_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="6">

                                <Border Background="#DBEAFE"
                        CornerRadius="10"
                        Padding="14"
                        Cursor="Hand" Width="102">

                                    <TextBlock x:Name="CreatedOrdersText"
                               Foreground="#1E40AF"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- IN DELIVERY -->
                            <Button Click="btnOrders_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="6">

                                <Border Background="#FEF3C7"
                        CornerRadius="10"
                        Padding="14"
                        Cursor="Hand" Width="102">

                                    <TextBlock x:Name="InDeliveryOrdersText"
                               Foreground="#92400E"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- DELIVERED -->
                            <Button Click="btnOrders_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="6">

                                <Border Background="#DCFCE7"
                        CornerRadius="10"
                        Padding="14"
                        Cursor="Hand" Width="102">

                                    <TextBlock x:Name="DeliveredOrdersText"
                               Foreground="#065F46"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>

                            <!-- FAILED -->
                            <Button Click="btnOrders_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="6">

                                <Border Background="#FEE2E2"
                        CornerRadius="10"
                        Padding="14"
                        Cursor="Hand" Width="102">

                                    <TextBlock x:Name="FailedOrdersText"
                               Foreground="#991B1B"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>

                        </UniformGrid>

                        <!-- ===== Time Status Summary ===== -->
                        <TextBlock Text="Delivery Time Status"
                   FontWeight="SemiBold"
                   Margin="0,8,0,6"/>

                        <UniformGrid Columns="3">
                            <Border Background="#DBEAFE" CornerRadius="10" Padding="5" Width="74">
                                <TextBlock x:Name="OnTimeOrdersText"
                           Text="On Time: 0"
                           Foreground="#1E40AF"
                           HorizontalAlignment="Left" Height="21"/>
                            </Border>

                            <Border Background="#FEF3C7" CornerRadius="10" Padding="5" Width="74">
                                <TextBlock x:Name="AtRiskOrdersText"
                           Text="At Risk: 0"
                           Foreground="#92400E"
                           HorizontalAlignment="Center" Height="21"/>
                            </Border>

                            <Border Background="#FEE2E2" CornerRadius="10" Padding="5" Width="74">
                                <TextBlock x:Name="LateOrdersText"
                           Text="Late: 0"
                           Foreground="#991B1B"
                           HorizontalAlignment="Center"/>
                            </Border>

                        </UniformGrid>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- CONFIGURATION -->
            <Border Style="{StaticResource Card}">
                <StackPanel>

                    <TextBlock Text="Configuration Variables"
                   Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Text="Max Range (km)" Grid.Row="0" Grid.Column="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding Configuration.MaxRange}" Grid.ColumnSpan="2" Margin="8,0,16,18" Grid.RowSpan="2"/>

                        <TextBlock Text="Sample Expiration (min)" Grid.Row="0" Grid.Column="3"/>
                        <TextBox Grid.Row="0" Grid.Column="4"
                     Text="{Binding Configuration.SampleExpirationMinutes}" Margin="14,0,-14,18" Grid.RowSpan="2"/>

                        <!-- Row 1 -->
                        <TextBlock Text="Max Delivery Duration (min)" Grid.Row="1" Grid.Column="0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Configuration.MaxDeliveryDurationMinutes}" Grid.ColumnSpan="2" Margin="8,0,16,18" Grid.RowSpan="2"/>

                        <TextBlock Text="Base Price" Grid.Row="1" Grid.Column="3"/>
                        <TextBox Grid.Row="1" Grid.Column="4"
                     Text="{Binding Configuration.BaseDeliveryPrice}" Margin="14,0,-14,18" Grid.RowSpan="2"/>

                        <!-- Row 2 -->
                        <TextBlock Text="Foot Speed" Grid.Row="2" Grid.Column="0"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding Configuration.FootSpeed}" Grid.ColumnSpan="2" Margin="8,18,16,18" Grid.RowSpan="3"/>

                        <TextBlock Text="Bike Speed" Grid.Row="2" Grid.Column="3"/>
                        <TextBox Grid.Row="2" Grid.Column="4"
                     Text="{Binding Configuration.BikeSpeed}" Margin="14,0,-14,18" Grid.RowSpan="2"/>

                        <!-- Row 3 -->
                        <TextBlock Text="Motorcycle Speed" Grid.Row="3" Grid.Column="0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Configuration.MotorcycleSpeed}" Grid.ColumnSpan="2" Margin="8,18,16,18" Grid.RowSpan="3"/>

                        <TextBlock Text="Car Speed" Grid.Row="3" Grid.Column="3"/>
                        <TextBox Grid.Row="3" Grid.Column="4"
                     Text="{Binding Configuration.CarSpeed}" Margin="14,0,-14,18" Grid.RowSpan="2"/>

                        <!-- Row 4 -->
                        <TextBlock Text="Price Per Km" Grid.Row="4" Grid.Column="0"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding Configuration.PricePerKm}" Grid.ColumnSpan="2" Margin="8,0,16,0"/>
                    </Grid>

                    <!-- UPDATE -->
                    <Button Content="Update Configuration"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Width="200"
                Style="{StaticResource PrimaryButton}"
                Click="btnUpdateConfig_Click"/>
                </StackPanel>
            </Border>


            <!-- MANAGEMENT -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Management" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="Couriers" Style="{StaticResource SecondaryButton}" Click="btnCouriers_Click"/>
                        <Button Content="Orders" Style="{StaticResource SecondaryButton}" Click="btnOrders_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- DB ACTIONS -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Init DB" Style="{StaticResource SecondaryButton}" Click="btnInitDB_Click"/>
                <Button Content="Reset DB"
                        Background="#DC2626"
                        Foreground="White"
                        Padding="14,8"
                        Margin="6"
                        BorderThickness="0"
                        Click="btnResetDB_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
